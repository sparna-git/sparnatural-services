med:P104 sh:name "est spécialité de référence dans";
  sh:description "Groupe générique pour lequel cette spécialité est la spécialité de référence";
  sh:class med:GroupeGenerique .

med:P105 sh:name "est spécialité générique dans";
  sh:description "Groupe générique pour lequel cette spécialité est une spécialité générique";
  sh:class med:GroupeGenerique .

med:P106 sh:name "est spécialité substituable dans";
  sh:description "Groupe générique pour lequel cette spécialité est une spécialité substituable";
  sh:class med:GroupeGenerique .

med:P107 sh:name "nom de gamme";
  sh:description "Gamme commerciale de cette spécialité";
  sh:minCount 1;
  sh:maxCount 1;
  sh:class med:Gamme .

med:P109 sh:name "identifiant de l'élément";
  sh:description "Identifiant (séquentiel) de l'élément dans la spécialité";
  sh:minCount 1;
  sh:maxCount 1;
  sh:datatype xsd:string .

med:P110 sh:name "libellé de l'élémént";
  sh:description "Libellé de l'élément";
  sh:minCount 1;
  sh:maxCount 1;
  sh:datatype rdf:langString;
  dash:propertyRole dash:LabelRole .

med:P111 sh:name "expression de dosage";
  sh:description "Expression de dosage d'un substance dans cet élément de spécialité";
  sh:minCount 1;
  sh:class med:ExpressionDeDosage;
  sh:severity sh:Warning .

med:P112 sh:name "compose";
  sh:description "Spécialité dont cet élément fait partie";
  sh:minCount 1;
  sh:maxCount 1;
  sh:class med:SpecialitePharmaceutique .

med:P113 sh:name "forme manufacturée (littérale)";
  sh:description "La forme manufacturée de cet élément, sous forme de chaine de caractères non normalisée";
  sh:minCount 1;
  sh:maxCount 1;
  sh:datatype xsd:string .

med:P115 sh:name "substance active";
  sh:description """Substance active dans l'élément (composant reconnu comme possédant des propriétés thérapeutiques).
Substance \"contenue dans la boite\" (qui n'est pas forcément identique à la substance dans laquelle est exprimée le dosage).""";
  sh:minCount 1;
  sh:class med:Substance;
  sh:severity sh:Warning .

med:P116 sh:name "fraction thérapeutique";
  sh:description """Substance qui porte l'activité pharmacologique, et qui est une partie d'une substance active.
Cette substance n'est donc pas directement \"contenue dans la boite\".
Tous les éléments n'ont pas forcément de fraction thérapeutique indiquée.""";
  sh:class med:Substance .

med:P117 sh:name "substance qui porte le dosage";
  sh:description "Substance de cet élément dans laquelle est exprimée son dosage.";
  sh:minCount 1;
  sh:class med:Substance;
  sh:severity sh:Warning .

med:P121 sh:name "libellé de l'expression de dosage";
  sh:description "Libellé de l'expression de dosage";
  sh:minCount 1;
  sh:maxCount 1;
  sh:datatype rdf:langString;
  dash:propertyRole dash:LabelRole .

med:P122 sh:name "substance de référence";
  sh:description "substance pour laquelle ce dosage est donné";
  sh:minCount 1;
  sh:maxCount 1;
  sh:class med:Substance .

med:P123 sh:name "expression quantité";
  sh:description "expression de la quantité dans l'expression de dosage";
  sh:minCount 1;
  sh:maxCount 1;
  sh:datatype xsd:string .

med:P125 sh:name "référence dosage";
  sh:description "Référence du dosage telle qu'exprimée dans les fichiers d'entrée. La cardinalité min est spécifiée à 1, cependant dans certains cas limites, la référence dosage peut ne pas renseignée.";
  sh:minCount 1;
  sh:maxCount 1;
  sh:datatype xsd:string;
  sh:severity sh:Warning .

med:P127 sh:name "sous forme de";
  sh:description "Substance de laquelle dérive la substance dont on exprime le dosage. La cardinalité max est spécifiée à 1, cependant dans certains cas spécifiques, la substance qui porte le dosage pourra être présente sous forme de plus d'une substance dans la spécialité.";
  sh:maxCount 1;
  sh:class med:Substance;
  sh:severity sh:Warning .

med:P128 sh:name "fraction thérapeutique";
  sh:description "Eventuelle fraction thérapeutique libérée par la substance dont on exprime le dosage";
  sh:class med:Substance .

med:P130 sh:name "identifiant";
  sh:description "Identifiant du groupe générique";
  sh:minCount 1;
  sh:maxCount 1;
  sh:datatype xsd:string .

med:P131 sh:name "libellé du groupe";
  sh:description """Libellé du groupe générique, par exemple \"PRASUGREL (CHLORHYDRATE DE) équivalent à PRASUGREL 10 mg - PRASUGREL
(BROMHYDRATE DE) équivalent à PRASUGREL 10 mg - PRASUGREL (BESILATE DE) équivalent à
PRASUGREL 10 mg - EFIENT 10 mg, comprimé pelliculé\"""";
  sh:minCount 1;
  sh:maxCount 1;
  sh:datatype rdf:langString;
  dash:propertyRole dash:LabelRole .

med:P132 sh:name "spécialité de référence";
  sh:description "Spécialité de référence (princeps) du groupe générique. Un groupe générique peut ne pas avoir de spécialité de référence, ou peut en avoir plusieurs.";
  sh:class med:SpecialitePharmaceutique .

med:P133 sh:name "spécialité générique";
  sh:description "Spécialité générique à la spécialité de référence.";
  sh:class med:SpecialitePharmaceutique .

med:P134 sh:name "spécialité substituable";
  sh:description "Spécialité non générique mais substituable à la spécialité de référence.";
  sh:class med:SpecialitePharmaceutique .

med:P136 sh:name "UCD 13";
  sh:description "Code UCD constitué de 13 chiffres (code principal)";
  sh:minCount 1;
  sh:maxCount 1;
  sh:datatype xsd:string .

med:P137 sh:name "UCD 7";
  sh:description "Code UCD constitué de 7 chiffres (ancien code)";
  sh:minCount 1;
  sh:maxCount 1;
  sh:datatype xsd:string .

med:P138 sh:name "libellé de l'UCD";
  sh:description "Libellé d'affichage principal. Le dernier libellé dans l'historique des libellés sera pris comme libellé d'affichage principal.";
  sh:minCount 1;
  sh:maxCount 1;
  sh:datatype rdf:langString;
  dash:propertyRole dash:LabelRole .

med:P139 sh:name "unité de dispensation de";
  sh:description "Référence à la spécialité pharmaceutique dispensée par cette UCD. Cet attribut est obligatoire et unique.";
  sh:minCount 1;
  sh:maxCount 1;
  sh:class med:SpecialitePharmaceutique .

med:P140 sh:name "présentée dans";
  sh:description "Référence à une présentation qui contient cette UCD. Plusieurs présentations peuvent contenir la même UCD.";
  sh:minCount 1;
  sh:class med:Presentation .

med:P143 sh:name "CIP13";
  sh:description "Code CIP constitué de 13 chiffres (code principal)";
  sh:minCount 1;
  sh:maxCount 1;
  sh:datatype xsd:string .

med:P144 sh:name "CIP7";
  sh:description "Code CIP constitué de 7 chiffres (ancien code). Il n'est pas toujours présent, c'est un identifiant historique.";
  sh:maxCount 1;
  sh:datatype xsd:string .

med:P145 sh:name "libellé de la présentation";
  sh:description "Libellé d'affichage principal. Le dernier libellé long dans l'historique des libellés sera pris comme libellé d'affichage principal (source ANSM).";
  sh:minCount 1;
  sh:maxCount 1;
  sh:datatype rdf:langString;
  dash:propertyRole dash:LabelRole;
