med:P146 sh:name "libellé court";
  sh:description "Libellé court principal. Le dernier libellé court dans l'historique des libellés sera pris comme valeur (source Club InterPharmaceutique).";
  sh:minCount 1;
  sh:maxCount 1;
  sh:datatype rdf:langString;
  sh:languageIn _:genid-f42a036d3d8b4dc89559949a5ba04d28194231-F652BE06B51A66DFCCF8636436551EF1 .

med:P147 sh:name "nombre d'unités de dispensation";
  sh:description "Donne le nombre d'unité de dispensation dans la présentation";
  sh:minCount 1;
  sh:maxCount 1;
  sh:datatype xsd:integer .

med:P148 sh:name "dispositif";
  sh:description "Type de dispositif d'administration dans cette présentation (exemple : \"cuillère-mesure\"). Il peut y avoir plusieurs dispositifs. Ce champs n'a pas été renseigné de façon systématique.";
  sh:datatype xsd:string .

med:P149 sh:name "présente la spécialité";
  sh:description "Référence à la spécialité pharmaceutique présentée dans cette présentation. Cet attribut est obligatoire et unique.";
  sh:minCount 1;
  sh:maxCount 1;
  sh:class med:SpecialitePharmaceutique .

med:P150 sh:name "contient unité de dispensation";
