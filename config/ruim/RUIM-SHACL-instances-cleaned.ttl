med:P83 sh:description """Référence à un élément de la classification ATC de cette spécialité. Cet attribut n'est pas historisé et contient la dernière valeur en date du code ATC. Les évolutions de l’ATC elle-même sont historisées dans le référentiel ATC. 
Pour certaines spécialités archivées, il est possible que la référence à l'ATC ne soit pas présente dans le cas où ce code aurait disparu avant l'ATC 2022. Après 2022 l'ATC est cumulative et mêmes les codes dépréciés restent présents.""";
  sh:maxCount 1 .

med:P84 sh:description "Code ATC sous forme littérale (par exemple “G04CA01”). Le code est explicitement répété en plus de la référence à l'URI principalement pour des questions d'affichage car le simple libellé de la catégorie est ambigü.";
  sh:minCount 1;
  sh:maxCount 1;
  sh:datatype xsd:string .

med:P85 sh:description "Le libellé de la classification ATC donné à cette spécialité dans les données source. En cas d'évolution de la classification ATC, ce libellé pourrait être différent du libellé de la classification ATC actuelle, et est conservé pour cette raison";
  sh:minCount 1;
  sh:maxCount 1;
  sh:datatype rdf:langString .

med:P86 sh:description "Référence à un évènement qui concerne cette spécialité (autorisation, changement de statut, changement de procédure, etc.)";
  sh:class med:Evenement .

med:P87 sh:description "Le régime de procédure courant de la spécialité. Le régime de procédure courant peut être différant du type de procédure de l'autorisation d'origine de la spécialité, dans les cas où un évènement à changé le type de procédure de la spécialité.";
  sh:minCount 1;
  sh:maxCount 1;
  sh:class med:TypeProcedure .

med:P88 sh:description """Le statut courant de la spécialité. Le statut peut évoluer au fil des évènements réglementaires qui concernent la spécialité.
Cet attribut capture seulement le dernier statut de la spécialité.""";
  sh:minCount 1;
  sh:maxCount 1;
  sh:class med:StatutSpecialite .

med:P89 sh:description "Référence à un ou plusieurs éléments dans cette spécialité";
  sh:class med:Element .

med:P90 sh:description """Substance active dans la spécialité (composant reconnu comme possédant des propriétés thérapeutiques).
Substance \"contenue dans la boite\" (qui n'est pas forcément identique à la substance dans laquelle est exprimée le dosage).
En principe toutes les spécialités ont au moins une substance active, mais des exceptions rares existent (les témoins de prick tests) où aucune substance active n'est répertoriée.""";
  sh:minCount 1;
  sh:class med:Substance;
  sh:severity sh:Warning .

med:P91 sh:description """Substance qui porte l'activité pharmacologique, et qui est une partie d'une substance active.
Cette substance n'est donc pas directement \"contenue dans la boite\".
Toutes les spécialités n'ont pas forcément de fraction thérapeutique indiquée.""";
  sh:class med:Substance .

med:P92 sh:description "Substance de cette spécialité dans laquelle est exprimée son dosage.";
  sh:minCount 1;
  sh:class med:Substance;
  sh:severity sh:Warning .

med:P93 sh:description "Forme pharmaceutique pour la prescription de la Spécialité";
  sh:minCount 1;
  sh:maxCount 1;
  sh:class med:Forme .

med:P94 sh:description "Indique si la substance portant le dosage est connue pour cette spécialité. Cette valeur est à false si la substance portant le dosage n'est pas connue.";
  sh:maxCount 1;
  sh:datatype xsd:boolean .

med:P95 sh:description """Référence à une UCD qui dispense cette spécialité.
Une Spécialité peut être dispensée dans plusieurs UCD. Une Spécialité peut être dispensée dans plusieurs UCD. Elle est dispensée dans au moins une UCD.""";
  sh:minCount 1;
  sh:class med:UniteCommuneDeDispensation .

med:P96 sh:description """Référence à une présentation qui présente cette spécialité.
Une Spécialité peut être présentée dans plusieurs présentations. Une Spécialité est présente dans au moins une présentation à partir du moment où elle a été commercialisée.""";
  sh:minCount 1;
  sh:class med:Presentation .

med:P99 sh:description "Indique a quel degré la spécialité est prescriptible en DC : prescriptible, non-prescriptible, prescriptible avec nom de marque.";
  sh:minCount 1;
  sh:maxCount 1;
  sh:class med:NiveauPrescriptibilite .

med:P101 sh:description """Indique la justification du positionnement du médicament par rapport à la prescription en DC (par exemple : spécialité radiopharmaceutique , homéopathie, phytothérapie, gaz médicinal, etc.). 
Cet attribut est obligatoire si le médicament est \"non prescriptible\" ou \"prescriptible avec nom de marque\". Il est vide si le médicament est \"prescriptible en dénomination commune\". Il peut être répété.""";
  sh:class med:JustificationNiveauPrescriptibilite .

med:P102 sh:description """Le titulaire est le détenteur de l'autorisation. Le plus souvent, il s'agit d'un laboratoire pharmaceutique.
Cette propriété donne le titulaire courant de la spécialité, qui peut changer dans le temps. Dans le passé, il est possible qu'une spécialité ait eu des co-titulaires, dans ce cas cette propriété est renseignée deux fois.""";
  sh:minCount 1;
  sh:maxCount 2;
  sh:class med:Organisation .

med:P103 sh:description "Une voie d'administration de cette spécialité";
  sh:minCount 1;
  sh:class med:Voie .

_:genid-f42a036d3d8b4dc89559949a5ba04d28194231-61F0140A36582927ED9EA5A2E1D09A17 sh:class
    med:SpecialitePharmaceutique .

_:genid-f42a036d3d8b4dc89559949a5ba04d28194231-6FAA2CC93FF8181DEF298DB2C950F8E1 sh:class
    med:Presentation .

med:BusinessRule_1 sh:message "La substance \"{?substanceDosage}\" n'existe pas dans la liste des substances de ce PhPID.";
  sh:select """PREFIX med: <http://data.esante.gouv.fr/ansm/medicament/>
SELECT $this ?substanceDosage
WHERE {
 $this (med:dosagePresentation|med:dosageConcentration)/med:substance ?substanceDosage .
 FILTER NOT EXISTS {
 $this med:substance ?substanceDosage .
 }
}""" .

med:BusinessRule_2 sh:message "La substance \"{?substanceDosage}\" n'existe pas dans la liste des substances de ce PhPID.";
  sh:select """PREFIX med: <http://data.esante.gouv.fr/ansm/medicament/>
SELECT $this ?substanceDosage
WHERE {
 $this (med:dosagePresentation|med:dosageConcentration)/med:substance ?substanceDosage .
 FILTER NOT EXISTS {
 $this med:substance ?substanceDosage .
 }
}""" .

med:BusinessRule_3 sh:message "La Présentation est liée à une prescription en DC sans que sa spécialitée soit prescriptible en DC.";
  sh:select """PREFIX med: <http://data.esante.gouv.fr/ansm/medicament/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT $this
WHERE {
 $this med:prescriptibleComme ?dc .
 FILTER NOT EXISTS {
 $this med:presente/med:prescriptibiliteEnDC ?niveauDc .
 # prescriptible en DC + avec nom de marque
 FILTER( ?niveauDc IN(med:NiveauPrescriptibilite_315, med:NiveauPrescriptibilite_317))
 }
}""" .

med:BusinessRule_4 sh:message "La Présentation d'une Spécialité prescriptible en DC n'est pas liée à une prescription en DC.";
  sh:select """PREFIX med: <http://data.esante.gouv.fr/ansm/medicament/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT $this
WHERE {
 $this med:presente/med:prescriptibiliteEnDC ?niveauDc .
 # prescriptible en DC + avec nom de marque
 FILTER( ?niveauDc IN(med:NiveauPrescriptibilite_315, med:NiveauPrescriptibilite_317))
 FILTER NOT EXISTS {
 $this med:prescriptibleComme ?dc .
 }
}""" .

med:BusinessRule_10 sh:message "La spécialité d'une Présentation ne se retrouve pas comme spécialité de l'UCD de cette Présentation";
  sh:select """PREFIX med: <http://data.esante.gouv.fr/ansm/medicament/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT $this
WHERE {
 $this med:presente ?specialite .
 $this med:contientUniteDeDispensation ?ucd .
 FILTER NOT EXISTS {
 ?ucd med:uniteDeDispensationDe ?specialite .
 }
}""" .

med:BusinessRule_16 sh:message "Une présentation ne peut avoir qu'un seul dosage concentration pour une substance donnée.";
  sh:select """PREFIX med: <http://data.esante.gouv.fr/ansm/medicament/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT $this ?value
WHERE {
 $this med:dosageConcentration ?dc .
 ?dc med:substance ?substance .
 $this med:dosageConcentration ?autreDc .
 ?autreDc med:substance ?substance .
 FILTER(?autreDc != ?dc && STR(?autreDc) < STR(?dc))
 BIND(?substance AS ?value) .
}""" .

med:BusinessRule_5 sh:message "L'élément présentation est lié à un PhPID4 sans que sa spécialité soit indiquée comme étant virtualisable.";
  sh:select """PREFIX med: <http://data.esante.gouv.fr/ansm/medicament/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT $this
WHERE {
 $this med:classementSubstanceDosageForme ?phpid4 .
 FILTER NOT EXISTS {
 $this med:compose/med:presente/med:niveauDeVirtualisation ?niveauVirt .
 FILTER( ?niveauVirt IN(med:Categorie_xx, med:Categorie_yy))
 }
}""" .

med:BusinessRule_6 sh:message "L'élément présentation d'une Spécialité virtualisable n'est pas liée à un PhPID4";
  sh:select """PREFIX med: <http://data.esante.gouv.fr/ansm/medicament/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT $this
WHERE {
 $this med:compose/med:presente/med:niveauDeVirtualisation ?niveauVirt .
 FILTER( ?niveauVirt IN(med:Categorie_xx, med:Categorie_yy))
 FILTER NOT EXISTS {
 $this med:classementSubstanceDosageForme ?phpid4 .
 }
}""" .

med:BusinessRule_7 sh:message "L'élément Présentation est lié à un PhPID1 sans être dans une Présentation d'une Spécialité partiellement virtualisable.";
  sh:select """PREFIX med: <http://data.esante.gouv.fr/ansm/medicament/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT $this
WHERE {
 $this med:classementSubstance ?phpid1 .
 FILTER NOT EXISTS {
 $this med:compose/med:presente/med:niveauDeVirtualisation ?niveauVirt .
 FILTER( ?categorie IN(med:Categorie_xx, med:Categorie_yy))
 }
}""" .

med:BusinessRule_8 sh:message "L'élément Présentation d'une Spécialité partiellement virtualisable n'est pas liée à un PhPID1";
  sh:select """PREFIX med: <http://data.esante.gouv.fr/ansm/medicament/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT $this
WHERE {
 $this med:compose/med:presente/med:niveauDeVirtualisation ?niveauVirt .
 FILTER( ?categorie IN(med:Categorie_xx, med:Categorie_yy))
 FILTER NOT EXISTS {
 $this med:classementSubstance ?phpid1 .
 }
}""" .

med:BusinessRule_9 sh:message "Le dosage n'est pas exprimé avec une quantité exacte ni avec un intervalle";
  sh:select """PREFIX med: <http://data.esante.gouv.fr/ansm/medicament/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT $this
WHERE {
 FILTER NOT EXISTS { $this med:quantiteSubstance ?qtt }
 FILTER NOT EXISTS { $this med:quantiteSubstanceInf ?qttInf . }
 FILTER NOT EXISTS { $this med:quantiteSubstanceSup ?qttSup . }
}""" .

med:BusinessRule_11 sh:message "Le libellé de la substance est en doublon avec une autre substance";
  sh:select """PREFIX med: <http://data.esante.gouv.fr/ansm/medicament/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT DISTINCT $this ?autreSub ?value
WHERE {
 $this rdfs:label|skos:altLabel ?unNom .
 OPTIONAL { ?this <http://data.esante.gouv.fr/ansm/medicament/codeSMS> ?sms .}
 ?autreSub rdfs:subClassOf <http://data.esante.gouv.fr/ansm/medicament/Substance> .
 OPTIONAL {?autreSub <http://data.esante.gouv.fr/ansm/medicament/codeSMS> ?autreSMS . }
 FILTER(?autreSub != $this)
 ?autreSub rdfs:label|skos:altLabel ?unNom .
 BIND(?unNom AS ?value)
}""" .

med:BusinessRule_12 sh:message "Un synonyme de Substance existe également en prefLabel";
  sh:select """PREFIX med: <http://data.esante.gouv.fr/ansm/medicament/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT $this ?unNom ?value
WHERE {
 $this skos:altLabel ?unNom .
 $this rdfs:label ?unNom .
 BIND(?unNom AS ?value)
}""" .

med:BusinessRule_13 sh:message "Un libellé préférentiel de Substance contient des parenthèses";
  sh:select """PREFIX med: <http://data.esante.gouv.fr/ansm/medicament/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT $this $PATH ?value
WHERE {
 $this rdfs:label ?value .
 FILTER( CONTAINS(STR(?value), \"(\") )
 FILTER( !CONTAINS(STR(?value), \"Homéopathie\") )
 BIND(rdfs:label AS $PATH)
}""" .

med:BusinessRule_14 sh:message "Une spécialité qui n'est pas prescriptible en DC n'a pas de justification associée.";
  sh:select """PREFIX med: <http://data.esante.gouv.fr/ansm/medicament/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT $this ?value
WHERE {
 $this med:prescriptibiliteEnDC ?value .
 FILTER(?value NOT IN (med:NiveauPrescriptibilite_315, med:NiveauPrescriptibilite_316))
 FILTER NOT EXISTS {
 $this med:justificationPrescriptibiliteEnDC ?justification .
 }
}""" .

med:BusinessRule_15 sh:message "TEMP : Une spécialité qui n'est pas virtualisable n'a pas de justification associée.";
  sh:select """PREFIX med: <http://data.esante.gouv.fr/ansm/medicament/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT $this ?value
WHERE {
 $this med:niveauDeVirtualisation ?value .
 FILTER(?value != med:NiveauVirtualisation_XXX)
 FILTER NOT EXISTS {
 $this med:justificationNiveauDeVirtualisation ?justification .
 }
}""" .

med:Component_sousClasseDe-nodeValidator sh:message "Value is not an rdfs:subClassOf {$sousClasseDe}";
  sh:select """PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?this WHERE {
 FILTER NOT EXISTS { 
 ?this rdfs:subClassOf+ $sousClasseDe .
 }
}""" .

med:Component_sousClasseDe-propertyValidator sh:message "Value is not an rdfs:subClassOf {$sousClasseDe}";
  sh:select """PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?this ?value WHERE {
 ?this ?PATH ?value .
 FILTER NOT EXISTS { 
 ?value rdfs:subClassOf+ $sousClasseDe .
 }
}""" .

med:Component_closedBySuperClasses-nodeValidator sh:message "Predicate not allowed {$path} : closed by super classes";
  sh:select """PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
SELECT $this (?predicate AS ?path) ?value
WHERE {
 FILTER ($closedBySuperClasses) .
 $this ?predicate ?value .
 FILTER (?predicate NOT IN (rdf:type, rdfs:subClassOf, owl:equivalentTo)) .
 FILTER NOT EXISTS {
 $this rdfs:subClassOf* ?class .
 ?class sh:property/sh:path ?predicate .
 }
}""" .

med:SpecialitePharmaceutique sh:sparql med:BusinessRule_14, med:BusinessRule_15 .

med:Presentation sh:sparql med:BusinessRule_3, med:BusinessRule_4, med:BusinessRule_10,
    med:BusinessRule_16 .

med:ElementPresentation sh:sparql med:BusinessRule_5, med:BusinessRule_6, med:BusinessRule_7,
    med:BusinessRule_8 .

med:Substance sh:sparql med:BusinessRule_11, med:BusinessRule_12, med:BusinessRule_13 .

med:turnIntoShClass sh:construct """PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX med: <http://data.esante.gouv.fr/ansm/medicament/>
CONSTRUCT {
 $this sh:node ?sousClasseDe
} WHERE {
 $this med:sousClasseDe ?sousClasseDe
}""" .

med:copiesEverything sh:construct """PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX med: <http://data.esante.gouv.fr/ansm/medicament/>
CONSTRUCT {
 $this ?p ?o .
 $this sh:target ?target .
 ?target ?p2 ?o2 .
} WHERE {
 $this ?p ?o .
 OPTIONAL { $this sh:target ?target . ?target ?p2 ?o2 }
}""" .

med:Component_sousClasseDe sh:parameter _:genid-f42a036d3d8b4dc89559949a5ba04d28194231-77EBABFBC7D480B6134E92B669EA67E0;
  sh:labelTemplate "The value must be a subClassOf {$sousClasseDe}";
  sh:nodeValidator med:Component_sousClasseDe-nodeValidator;
  sh:propertyValidator med:Component_sousClasseDe-propertyValidator .

med:Component_closedBySuperClasses sh:parameter _:genid-f42a036d3d8b4dc89559949a5ba04d28194231-0077822DE86100E4FE2212DD59D88655;
  sh:labelTemplate "The property does not belong to a superclass";
  sh:nodeValidator med:Component_closedBySuperClasses-nodeValidator .

med:Diagramme_SpecialitesPresentationsUCD sh:order 1 .

med:Diagramme_ElementDosages sh:order 2 .

med:Diagramme_PrescriptionEnDC sh:order 3 .

med:Diagramme_PhPIDs sh:order 4 .
